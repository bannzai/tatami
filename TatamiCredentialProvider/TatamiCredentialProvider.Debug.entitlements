<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Debug は ad-hoc 署名 (provisioning profile なし) のため、profile が要る autofill-credential-provider と keychain-access-groups を含めない (documents/adr/0004) -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
