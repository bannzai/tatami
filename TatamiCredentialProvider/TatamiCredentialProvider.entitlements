<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- macOS の app extension は App Sandbox が必須 -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- システム設定の「自動入力とパスワード」に Tatami を表示するための entitlement (provisioning profile が要る) -->
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
	<!-- アプリと同じ access group で Password Manager の Keychain アイテムを共有する (documents/adr/0004) -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.bannzai.Tatami.shared</string>
	</array>
</dict>
</plist>
