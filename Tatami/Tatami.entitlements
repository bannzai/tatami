<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime が有効なため、Web ページの getUserMedia でカメラ・マイクを使うには entitlement が要る -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Password Manager の Keychain アイテムを Credential Provider Extension と共有するための access group (documents/adr/0004) -->
	<!-- 本体からも ASCredentialIdentityStore を更新するため (自動入力候補の同期)。Team 署名でのみ付く (Debug の ad-hoc は profile が要るため付けない) -->
	<key>com.apple.developer.authentication-services.autofill-credential-provider</key>
	<true/>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.bannzai.Tatami.shared</string>
	</array>
</dict>
</plist>
