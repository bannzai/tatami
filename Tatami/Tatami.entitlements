<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened Runtime が有効なため、Web ページの getUserMedia でカメラ・マイクを使うには entitlement が要る -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Password Manager の Keychain アイテムを Credential Provider Extension と共有するための access group (documents/adr/0004) -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.bannzai.Tatami.shared</string>
	</array>
</dict>
</plist>
